{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "deviceSerial",
            "type": "pickString",
            "description": "选择目标设备",
            "options": [
                "emulator-5556",
                "NXFo208BAE76z281009",
                "192.168.31.216:5555"
            ],
            "default": "emulator-5556"
        }
    ],
    "tasks": [
        {
            "label": "install & launch (debug)",
            "type": "shell",
            "command": "./gradlew :app:installDebug && adb shell am start -n com.lanlinju.animius/.MainActivity",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "JAVA_HOME": "C:/Program Files/Android/Android Studio/jbr"
                }
            }
        },
        {
            "label": "install & launch (emulator only)",
            "type": "shell",
            "command": "./gradlew :app:installDebug && adb -s ${input:deviceSerial} shell am start -n com.lanlinju.animius/.MainActivity",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "JAVA_HOME": "C:/Program Files/Android/Android Studio/jbr",
                    "ANDROID_SERIAL": "${input:deviceSerial}"
                }
            }
        }
    ]
}